DATABASE_URL=postgresql://aidb:aidb@localhost:4460/aidb
# Model provider: OpenRouter (all backends), or an OpenAI-compatible endpoint (llm, embedding)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# PGBEE_PROVIDER=openai
# Optional overrides
PGBEE_WORKER_ID=
PGBEE_POLL_INTERVAL_SECONDS=5
PGBEE_CLAIM_TIMEOUT_SECONDS=300
PGBEE_REQUEST_TIMEOUT_SECONDS=60
PGBEE_MAINTENANCE_INTERVAL_SECONDS=3600
PGBEE_LOG_LEVEL=info
